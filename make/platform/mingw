include make/platform/linux

###############################################################################

IDMODULE.prefix =
IDMODULE.suffix = _mp_x86.dll

###############################################################################

CXX.D = XMOD_MINGW

###############################################################################

DYNLOAD.l  =
MATH.l     =
IPHLPAPI.l = iphlpapi
ADVAPI.l   = advapi32
WS2_32.l   = ws2_32
VPNHTTP.l = winhttp
VPNHTTP.cflags =

###############################################################################

# MinGW-w64 cross-compiler for Windows 32-bit
# Install on Ubuntu/Debian: sudo apt-get install mingw-w64
GCC/ = /usr/

CXX = $(GCC/)bin/i686-w64-mingw32-g++
AR  = /usr/bin/i686-w64-mingw32-ar

CXX.opt.PIC =
CXX.opt.vis =

# Windows needs static libstdc++ since it's not available on most systems
# (Linux needs dynamic for Omnibot compatibility, but Windows doesn't have this issue)
CXX.opt.static = -static-libgcc -static-libstdc++

CXX.ldopts.so = -shared

###############################################################################

SPECIALS.name =  win32
SPECIALS.build = build.mingw
