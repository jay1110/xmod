CXX.O = 1
# Use cross-compiler strip when cross-compiling, otherwise native strip
ifeq ($(CROSS_COMPILE),1)
CXX.fnStrip = aarch64-linux-gnu-strip $(1)
else
CXX.fnStrip = strip $(1)
endif

# Don't statically link libstdc++ - it conflicts with Omnibot's dynamic libstdc++
# causing crashes in C++ runtime (iostream, locale, etc.)
CXX.libstdcxx.DEPS =
CXX.static         = 1
