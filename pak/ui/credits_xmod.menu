#include "ui/menudef.h"

// Defines //

#define WINDOW_X		16
#define WINDOW_Y		16
#define WINDOW_WIDTH	608
#define WINDOW_HEIGHT	448
#define GROUP_NAME		"grpXmodCredits"

// Macros //

#include "ui/menumacros.h"
		
// Additional Menu //
	
menuDef {
	name		"credits_xmod"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
	
	onESC {
		close credits_xmod ;
		open xmod_options
	}

// Window //

	itemDef {
		name		"window"
		group		GROUP_NAME
		rect		0 0 WINDOW_WIDTH WINDOW_HEIGHT
		style		WINDOW_STYLE_FILLED
		backcolor	0.01 0.01 0.01 .95
		border		WINDOW_BORDER_FULL
		bordercolor	.5 .5 .5 .5
		visible		1
		decoration
	}
	
// Logo //

#define LOGOBAR_WIDTH 96+16+96+16+64+16+64

	
	itemDef {
		name		"logoXmod"
		rect		$evalfloat(0.5 * (WINDOW_WIDTH - 64)) $evalfloat(10) 64 64
		style		WINDOW_STYLE_SHADER
		background	"ui/assets/xmod"
		forecolor	1 1 1 1
		visible		1
		decoration
	}
// Credits Sections //

#define CREDITS_Y	84
	
// Dev Team //
	itemDef {
		name		"headerDevTeam"
		group		GROUP_NAME
		rect		6 $evalfloat(CREDITS_Y) $evalfloat(WINDOW_WIDTH-12) 12
		text		"EXXTREM TERROR CLAN"
		textfont	UI_FONT_ARIBLK_16
		textstyle	ITEM_TEXTSTYLE_SHADOWED
		textscale	.25
		textalign	ITEM_ALIGN_CENTER
		textalignx	$evalfloat(.5*(WINDOW_WIDTH-12))
		textaligny	10
		forecolor	1 1 1 1
		visible		1
		decoration
	}


	LABELWHITE( (0.5*WINDOW_WIDTH)-100, CREDITS_Y+18, 200, 12, "Developed by:", .25, ITEM_ALIGN_CENTER, 100, 8 )
	LABELWHITE( (0.5*WINDOW_WIDTH)-100, CREDITS_Y+30, 200, 10, "^7ET^uc|^f#.^dJa^4y^9.#", .3, ITEM_ALIGN_CENTER, 100, 8 )
	LABELWHITE( (0.5*WINDOW_WIDTH)-100, CREDITS_Y+50, 300, 12, "^dXMOD^7: is a fork of ^xJAY^4MOD", .25, ITEM_ALIGN_CENTER, 100, 8 )
	LABELWHITE( (0.5*WINDOW_WIDTH)-100, CREDITS_Y+62, 300, 12, "^7With additional features.", .25, ITEM_ALIGN_CENTER, 100, 8 )
    LABELWHITE( (0.5*WINDOW_WIDTH)-100, CREDITS_Y+84, 350, 12, "^7Full details you can find at ^3etclan.de/xmod", .25, ITEM_ALIGN_CENTER, 100, 8 )
    LABELWHITE( (0.5*WINDOW_WIDTH)-100, CREDITS_Y+96, 390, 12, "^7report bugs and features requests to ^3discord.etclan.de", .25, ITEM_ALIGN_CENTER, 100, 8 )


// Buttons //
	BUTTON( 6, WINDOW_HEIGHT-24, .33*(WINDOW_WIDTH-24), 18, "^7BACK", .3, 14, close credits_xmod ; open xmod_options )
	BUTTON( 6+.33*(WINDOW_WIDTH-24)+6, WINDOW_HEIGHT-24, .34*(WINDOW_WIDTH-24), 18, "^xJAY^4MOD", .3, 14, close credits_xmod ; open credits_jaymod) 
}

