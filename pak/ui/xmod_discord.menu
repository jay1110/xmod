#include "ui/menudef.h"

// Defines //

#define WINDOW_X        0
#define WINDOW_Y        0
#define WINDOW_WIDTH    640
#define WINDOW_HEIGHT   480
#define GROUP_NAME      "grpWWWConfirm"

// Macros //

#include "ui/menumacros.h"
        
// WWW Confirmation Menu //
    
menuDef
{
    name        "xmod_discord"
    visible     0
    fullscreen  0
    rect        WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
    style       WINDOW_STYLE_GRADIENT
    popup
    
    fadeClamp   0.5
    
    onOpen
    {
        setitemcolor background backcolor 0 0 0 0 ;
        fadein background
        exec "set cl_noprint 1;exec ui/xmod_discord.cfg;set cl_noprint 0"
    }
    
    onESC {
        close xmod_discord ;
#ifdef FUI
        open main
#else
        open xmod_options
#endif // FUI
    }
    
// Background //
    itemDef {
        name        "background"
        rect        0 0 640 480
        style       WINDOW_STYLE_GRADIENT
        //background "ui/assets/fadebox.tga"
        backcolor   0.01 0.01 0.01 .95
        visible     1
        decoration
    }

    itemDef {
        name        "window"
        group       GROUP_NAME
        rect        0 0 WINDOW_WIDTH WINDOW_HEIGHT
        style       WINDOW_STYLE_GRADIENT
        backcolor   0.01 0.01 0.01 .95
        border      WINDOW_BORDER_KCGRADIENT
        bordercolor .5 .5 .5 .5
        visible     1
        decoration
    }

// Subwindows //

#define SUBWINDOW_WIDTH     360
#define SUBWINDOW_HEIGHT    180
#define SUBWINDOW_X         .5 * (WINDOW_WIDTH - SUBWINDOW_WIDTH)
#define SUBWINDOW_Y         .5 * (WINDOW_HEIGHT - SUBWINDOW_HEIGHT)

    // Titel + Panel
    SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "^dXmod ^oDiscord" )

    // Info-Texte
    LABEL( SUBWINDOW_X+2, SUBWINDOW_Y+20, (SUBWINDOW_WIDTH)-4, 10,
           "^7Join Xmod Discord server!", .22, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-4), 8 )

    LABEL( SUBWINDOW_X+2, SUBWINDOW_Y+32, (SUBWINDOW_WIDTH)-4, 10,
           "^7Post your features requests and report bugs.^7", .20, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-4), 8 )

    LABEL( SUBWINDOW_X+2, SUBWINDOW_Y+58, (SUBWINDOW_WIDTH)-4, 10,
           "^7", .18, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-4), 8 )

    LABEL( SUBWINDOW_X+2, SUBWINDOW_Y+70, (SUBWINDOW_WIDTH)-4, 10,
           "^7", .18, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-4), 8 )
    LABEL( SUBWINDOW_X+2, SUBWINDOW_Y+82, (SUBWINDOW_WIDTH)-4, 10,
           "^7", .18, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-4), 8 )


    // kleiner Trenner
    itemDef {
        name        "divider"
        group       GROUP_NAME
        rect        $evalfloat(SUBWINDOW_X+8) $evalfloat(SUBWINDOW_Y+100) $evalfloat(SUBWINDOW_WIDTH-16) 1
        style       WINDOW_STYLE_FILLED
        backcolor   .6 .6 .6 .4
        visible     1
        decoration
    }
	
	    LABEL( SUBWINDOW_X+2, SUBWINDOW_Y+115, (SUBWINDOW_WIDTH)-4, 10,
           "^7https://discord.etclan.de", .22, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-4), 8 )

#ifdef FUI
    // YES / NO – Hauptmenü-Variante
    BUTTON( SUBWINDOW_X+6, SUBWINDOW_Y+SUBWINDOW_HEIGHT-24,
            .5*(SUBWINDOW_WIDTH-18), 18,
            "YES", .3, 14,
            close xmod_discord ; close main ; open credits_quit )

    BUTTON( SUBWINDOW_X+6+.5*(SUBWINDOW_WIDTH-18)+6, SUBWINDOW_Y+SUBWINDOW_HEIGHT-24,
            .5*(SUBWINDOW_WIDTH-18), 18,
            "NO", .3, 14,
            close xmod_discord ; open main )
#else
    // YES / NO – Ingame-Variante
    BUTTON( SUBWINDOW_X+6, SUBWINDOW_Y+SUBWINDOW_HEIGHT-24,
            .5*(SUBWINDOW_WIDTH-18), 18,
            "YES", .3, 14,
            close xmod_discord ; uiScript validate_openURL )

    BUTTON( SUBWINDOW_X+6+.5*(SUBWINDOW_WIDTH-18)+6, SUBWINDOW_Y+SUBWINDOW_HEIGHT-24,
            .5*(SUBWINDOW_WIDTH-18), 18,
            "NO", .3, 14,
            close xmod_discord ; open xmod_options )
#endif // FUI

}
