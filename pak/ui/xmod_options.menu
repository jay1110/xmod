#include "ui/menudef.h"

// Defines //

#define WINDOW_X		16
#define WINDOW_Y		16
//#define WINDOW_WIDTH	128
#define WINDOW_WIDTH	160
#define WINDOW_HEIGHT	224
#define GROUP_NAME		"grpXmod"

// Macros //

#include "ui/menumacros.h"

// Main Menu //

menuDef {
	name		"xmod_options"
	visible		0
	fullscreen	0
	rect		WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style		WINDOW_STYLE_FILLED
  
	onOpen {
		// ydnar
		conditionalscript ROldModeCheck 2
			( "clearFocus ; open vid_confirm" )
			( "clearFocus" )
	}
	
	onEsc {
		close xmod_options ;
		open ingame_main
	}

// Window //

	WINDOW( "^dXMOD", 50 )
	
// Buttons //

	BUTTON( 6, 32, WINDOW_WIDTH-12, 18, "^7DISPLAY", .3, 14, close xmod_options ; open xmod_display )
	BUTTON( 6, 56, WINDOW_WIDTH-12, 18, "^7SOUND", .3, 14, close xmod_options ; open xmod_sound )
	BUTTON( 6, 80, WINDOW_WIDTH-12, 18, "^7MISC", .3, 14, close xmod_options ; open xmod_misc )
	BUTTON( 6, 104, WINDOW_WIDTH-12, 18, "^7CREDITS", .3, 14, close xmod_options ; open credits_xmod )
	BUTTON( 6, 128, WINDOW_WIDTH-12, 18, "^7SUPPORT", .3, 14, close xmod_options ; open xmod_website )
	BUTTON( 6, 152, WINDOW_WIDTH-12, 18, "^7Dev-Server", .3, 14, close xmod_options ; open xmod_devserver )
	BUTTON( 6, 176, WINDOW_WIDTH-12, 18, "^7Discord", .3, 14, close xmod_options ; open xmod_discord )
	BUTTON( 6, 200, WINDOW_WIDTH-12, 18, "BACK", .3, 14, close xmod_options ; open ingame_main )
}
