#include "ui/menudef.h"

#define WINDOW_X        16
#define WINDOW_Y        16
#define WINDOW_WIDTH    608
#define WINDOW_HEIGHT   390
#define GROUP_NAME      "grpxDisplay"

#include "ui/menumacros.h"

menuDef {
	name        "xmod_display"
	visible     0
	fullscreen  0
	rect        WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
	style       WINDOW_STYLE_FILLED

	onESC {
		close xmod_display ;
		open xmod_options ;
	}

	WINDOW( "^d Xmod ^7Display^7", 94 )

#define SUBWINDOW_WIDTH     296
#define LEFT_X              6
#define RIGHT_X             308

	// LINKE SPALTE //

	// Draw Options
	SUBWINDOW( LEFT_X, 32, (SUBWINDOW_WIDTH), 138, "^oDRAW" )
	YESNO(  LEFT_X+2, 48,  (SUBWINDOW_WIDTH)-4, 10, "^7Muzzle Flash:",     .2, 8, "cg_muzzleFlash",     "^0Toggle Muzzle Flash" )
	MULTI(  LEFT_X+2, 60,  (SUBWINDOW_WIDTH)-4, 10, "^7Bullet Tracers:",   .2, 8, "cg_tracers",         cvarFloatList { "^1No" 0 "^dYes" 1 "^dYes, but not my own" 2 }, "^0Toggle Bullet Tracers" )
	YESNO(  LEFT_X+2, 72,  (SUBWINDOW_WIDTH)-4, 10, "^7Explosions:",       .2, 8, "cg_wolfParticles",   "^0Toggle Explosions" )
	YESNO(  LEFT_X+2, 84,  (SUBWINDOW_WIDTH)-4, 10, "^7Smoke:",            .2, 8, "cg_smokeparticles",  "^0Toggle Smoke Particles" )
	YESNO(  LEFT_X+2, 96,  (SUBWINDOW_WIDTH)-4, 10, "^7Impact Particles:", .2, 8, "cg_impactparticles", "^0Toggle Impact Particles" )
	YESNO(  LEFT_X+2, 108, (SUBWINDOW_WIDTH)-4, 10, "^7Trails:",           .2, 8, "cg_trailparticles",  "^0Toggle Grenade, Panzer, and Mortar Trails" )
	YESNO(  LEFT_X+2, 120, (SUBWINDOW_WIDTH)-4, 10, "^7Player Shadows:",   .2, 8, "cg_shadows",         "^0Toggle player shadows" )
	MULTI(  LEFT_X+2, 132, (SUBWINDOW_WIDTH)-4, 10, "^7Draw Gun Color:",   .2, 8, "cg_drawgun",         cvarFloatList { "^1Remove gun" 0 "^dEnable Gun" 1 "^0black" 2 "^1red" 3 "^2green" 4 "^3yellow" 5 "^4blue" 6 "^5cyan" 7 "^6magenta" 8 "^7white" 9 "^8orange" 10 "^9gray" 11 "^:light gray" 12 "^<dark green" 13 "^=olive" 14 "^>dark blue" 15 "^?dark red" 16 "^@brown" 17 "^alight orange" 18 "^bteal" 19 "^cpurple" 20 "^dsky blue" 21 "^eviolet" 22 "^fsteel blue" 23 "^glight green" 24 "^hforest green" 25 "^ired-pink" 26 "^jdark red" 27 "^ltan" 29 "^molive" 30 "^nlight yellow" 31 }, "Gun Alpha Color" )
	SLIDER( LEFT_X+2, 144, (SUBWINDOW_WIDTH)-4, 10, "^7Drawgun Alpha:",     .2, 8, "cg_drawgunalpha" 1 0 255, "Change visibility of the gun" )
	YESNO(  LEFT_X+2, 156,  (SUBWINDOW_WIDTH)-4, 10, "^7Missile Cam:",     .2, 8, "cg_drawcam",     "^0Toggle Missile Cam for panzerfaust, mortar and rifle." )

	

	// HUD Options
	SUBWINDOW( LEFT_X, 174, (SUBWINDOW_WIDTH), 116, "^oHUD" )
	MULTI(  LEFT_X+2, 190, (SUBWINDOW_WIDTH)-4, 10, "^7Use Xmod-style HUD:",   .2, 8, "cg_althud",              cvarFloatList { "^2No" 0 "^dYes" 1 }, "Use the Xmod-style Heads-Up-Display." )
	MULTI(  LEFT_X+2, 202, (SUBWINDOW_WIDTH)-4, 10, "^7Obituary Location:",    .2, 8, "cg_obituaryLocation",    cvarFloatList { "^dLeft Side" 0 "^dChat Area" 1 }, "The area of the screen you want obituaries to be displayed." )
	MULTI(  LEFT_X+2, 214, (SUBWINDOW_WIDTH)-4, 10, "^7Obituary Filter:",      .2, 8, "cg_obituaryFilter",      cvarFloatList { "^dShow all" 0 "^dRelevant" 1 "^dShow None" 2 }, "Choose which obituaries you want to see." )
	MULTI(  LEFT_X+2, 226, (SUBWINDOW_WIDTH)-4, 10, "^7HUD Background Color:", .2, 8, "cg_hudBackgroundColor",  cvarStrList { "Default"; ".16 .2 .17 .8"; "White"; "1 1 1 .8"; "Yellow"; "1 1 0 .8"; "Red"; "1 0 0 .8"; "Green"; "0 1 0 .8"; "Blue"; "0 0 1 .8"; "Black"; "0 0 0 .8" }, "HUD Background Color" )
	MULTI(  LEFT_X+2, 238, (SUBWINDOW_WIDTH)-4, 10, "^7HUD Border Color:",     .2, 8, "cg_hudBorderColor",      cvarStrList { "Default"; ".5 .5 .5 .5"; "White"; "1 1 1 .8"; "Yellow"; "1 1 0 .8"; "Red"; "1 0 0 .8"; "Green"; "0 1 0 .8"; "Blue"; "0 0 1 .8"; "Black"; "0 0 0 .8" }, "HUD Border Color" )
	SLIDER( LEFT_X+2, 250, (SUBWINDOW_WIDTH)-4, 10, "^7HUD Alpha:",            .2, 8, "cg_hudAlpha" .8 0 1, "Transparency of HUD" )
	SLIDER( LEFT_X+2, 262, (SUBWINDOW_WIDTH)-4, 10, "^7Watermark Opacity:",    .2, 8, "cg_watermarkOpacity" 1 0 1, "Set the transparency level for the server's watermark." )
	SLIDER( LEFT_X+2, 274, (SUBWINDOW_WIDTH)-4, 10, "^7Compass Zoom:",         .2, 8, "cg_mapZoom" 1.2 1 7.43, "Set the amount of zoom for the compass." )

	// Crosshair & Names
	SUBWINDOW( LEFT_X, 294, (SUBWINDOW_WIDTH), 68, "^oCROSSHAIR & NAMES" )
	LABEL( LEFT_X+10, 308, (SUBWINDOW_WIDTH)-4, 10, "^7Crosshair Name Drawing", .20, ITEM_ALIGN_LEFT, 8, 8 )
	//CHECKBOXACTIONBITFLAG( LEFT_X+140, 308, 60, 10, "Enable", .2, 10, 8, "cg_drawCrosshairNames", 1, togglecvarbit cg_drawCrosshairNames 1, "Enable Name Drawing" )
	//CHECKBOXACTIONBITFLAG( LEFT_X+210, 320, 60, 10, "Ranks", .2, 10, 8, "cg_drawCrosshairNames", 2, togglecvarbit cg_drawCrosshairNames 2, "Draw Player Ranks" )
	YESNO(  LEFT_X+2, 324, (SUBWINDOW_WIDTH)-4, 10, "^7Wounded Player Names:",  .2, 8, "cg_woundedNames",        "Draw names above players waiting for revives" )
	YESNO(  LEFT_X+2, 336, (SUBWINDOW_WIDTH)-4, 10, "^7Descriptive Text:",      .2, 8, "cg_descriptiveText",     "Show Spectator Info" )
	MULTI(  LEFT_X+2, 348, (SUBWINDOW_WIDTH)-4, 10, "^7Spectator Names:",      .2, 8, "cg_drawSpectatorNames",      cvarFloatList { "^dOff" 0 "^dShow" 1 "^dShow" 2 }, "Show spectator names" )

	// RECHTE SPALTE //

	// Utilities
	SUBWINDOW( RIGHT_X, 32, (SUBWINDOW_WIDTH), 136, "^oUTILITIES" )
	MULTI(  RIGHT_X+2, 48,  (SUBWINDOW_WIDTH)-4, 10, "^7Frames Per Second:",        .2, 8, "cg_drawfps",     cvarFloatList { "^dOff" 0 "^dOn" 1 }, "Show Frames Per Second" )
	MULTI(  RIGHT_X+2, 60,  (SUBWINDOW_WIDTH)-4, 10, "^7Show Lag-O-Meter:",         .2, 8, "cg_lagometer",   cvarFloatList { "^dOff" 0 "^dOn" 1 }, "Show the Lag-O-Meter" )
	MULTI(  RIGHT_X+2, 72,  (SUBWINDOW_WIDTH)-4, 10, "^7Draw Ping:",                .2, 8, "cg_drawPing",    cvarFloatList { "^dOff" 0 "^dOn" 1 }, "Draw Ping" )
	MULTI(  RIGHT_X+2, 84,  (SUBWINDOW_WIDTH)-4, 10, "^7Local Time:",               .2, 8, "cg_drawClock",   cvarFloatList { "^dOff" 0 "^d12 Hour" 1 "^d24 Hour" 2 }, "Display the local time" )
	MULTI(  RIGHT_X+2, 96,  (SUBWINDOW_WIDTH)-4, 10, "^7Spawnshield Timer:",        .2, 8, "cg_drawSpawnShieldTimer",   cvarFloatList { "^dOff" 0 "^dOn" 1 }, "Display spawnshield indicator and timer" )
	MULTI(  RIGHT_X+2, 108,  (SUBWINDOW_WIDTH)-4, 10, "^7Speedometer:",              .2, 8, "cg_drawSpeed",   cvarFloatList { "^dOff" 0 "^dUPS" 1 "^dUPS + Max" 2 "^dkm/hr" 3 "^dkm/hr + Max" 4 "^dmi/hr" 5 "^dmi/hr + Max" 6 }, "Display player's speed" )
	//MULTI(  RIGHT_X+2, 108, (SUBWINDOW_WIDTH)-4, 10, "^7Speed Units:",              .2, 8, "cg_speedunit",   cvarFloatList { "^dUPS" 0 "^dKPH" 1 "^dMPH" 2 }, "Speed unit" )
	SLIDER( RIGHT_X+2, 120, (SUBWINDOW_WIDTH)-4, 10, "^7Speedometer Delay:", .2, 8, "cg_speedRefresh" 25 0 200, "Update delay for speedometer" )
	MULTI(  RIGHT_X+2, 132, (SUBWINDOW_WIDTH)-4, 10, "^7Country Flags:",            .2, 8, "cg_countryflags", cvarFloatList { "^dOff" 0 "^dOn" 1 }, "Draw Country Flags" )
	MULTI(  RIGHT_X+2, 144, (SUBWINDOW_WIDTH)-4, 10, "^7Objective Hints:",          .2, 8, "cg_drawObjectiveIndicators", cvarFloatList { "^dOff" 0 "^dOn" 1 "^dOn+Distance" 2 }, "Draw objective hints" )
	MULTI(  RIGHT_X+2, 156, (SUBWINDOW_WIDTH)-4, 10, "^7OBJ hints distance:",  .2, 8, "cg_objectiveIndicatorMaxDist",           cvarFloatList { "^dMax distance" 0 "^d1" 100 "^d200" 200 "^d300" 300 "^d400" 400 "^d500" 500 "^d600" 600 "^d700" 700 "^d800" 800 "^d900" 900 "^d1000" 1000 "^d1100" 1100 "^d1200" 1200 "^d1300" 1300 "^d1400" 1400 "^d1500" 1500 "^d1600" 1600 "^d1700" 1700 "^d1800" 1800 "^d1900" 1900 "^d2000" 2000 }, "hide objective hints, when reaching the value" )

	// Popups
	SUBWINDOW( RIGHT_X, 172, (SUBWINDOW_WIDTH), 76, "^oPOPUPS" )
	MULTI(  RIGHT_X+2, 188, (SUBWINDOW_WIDTH)-4, 10, "^7Icon Size:",         .2, 8, "cg_drawSmallPopupIcons", cvarFloatList { "^2Normal" 0 "^dSmall" 1 }, "Icon size for popup messages" )
	MULTI(  RIGHT_X+2, 200, (SUBWINDOW_WIDTH)-4, 10, "^7Number of Popups:",  .2, 8, "cg_numPopups",           cvarFloatList { "^dOff" 0 "^d1" 1 "^d2" 2 "^d3" 3 "^d4" 4 "^d5" 5 "^d6" 6 "^d7" 7 "^d8" 8 "^d9" 9 "^d10" 10 "^d11" 11 "^d12" 12 "^d13" 13 "^d14" 14 "^d15" 15 "^d16" 16 "^d17" 17 "^d18" 18 "^d19" 19 "^d20" 20 }, "Number of popups displayed" )
	SLIDER( RIGHT_X+2, 212, (SUBWINDOW_WIDTH)-4, 10, "^7Popup Delay:",       .2, 8, "cg_popupTime"     1000 0 1500, "Time between popups" )
	SLIDER( RIGHT_X+2, 224, (SUBWINDOW_WIDTH)-4, 10, "^7Popup Duration:",    .2, 8, "cg_popupWaitTime" 2000 0 4000, "Popup display time" )
	SLIDER( RIGHT_X+2, 236, (SUBWINDOW_WIDTH)-4, 10, "^7Popup Fade:",        .2, 8, "cg_popupFadeTime" 2500 0 5000, "Popup fade time" )

	// Fireteam & Location
	SUBWINDOW( RIGHT_X, 252, (SUBWINDOW_WIDTH), 76, "^oFIRETEAM & LOCATION" )
	MULTI(  RIGHT_X+2, 268, (SUBWINDOW_WIDTH)-4, 10, "^7Draw Location:",        .2, 8, "cg_locations",        cvarFloatList { "Coordinates only" 0 "Fire-Team only" 1 "Team-Chat only" 2 "Team-Chat+Fire-Team" 3 }, "Location display options" )
	MULTI(  RIGHT_X+2, 280, (SUBWINDOW_WIDTH)-4, 10, "^7Fireteam Locations:",    .2, 8, "cg_locationMode",     cvarFloatList { "^dDefault (Names)" 0 "^dLocation Names" 1 "^dCoordinates" 2 "^dNames + Coords" 3 "^dNames, no PVS check" 5 "^dNames + Coords (PVS)" 7 "^dNames when Unknown" 9 "^dNames + Coords (Unknown)" 11 "^dNames (PVS)(Unknown)" 13 "^dNames + Coords (PVS)(Unknown)" 15 }, "Fireteam location display" )
	SLIDER( RIGHT_X+2, 292, (SUBWINDOW_WIDTH)-4, 10, "^7Location Max Chars:",     .2, 8, "cg_locationMaxChars" 25 0 76, "Max characters for location names" )
	MULTI(  RIGHT_X+2, 304, (SUBWINDOW_WIDTH)-4, 10, "^7Location Justify:",       .2, 8, "cg_locationJustify",  cvarFloatList { "^dLeft no padding" 0 "^dLeft with padding" -1 "^dRight with padding" 1 }, "^dLocation text justification" )
	YESNO(  RIGHT_X+2, 316, (SUBWINDOW_WIDTH)-4, 10, "^7Auto Select FT Buddies:", .2, 8, "cg_FTAutoSelect",     "Auto-select fireteam buddies" )

	// Auto Map
	//SUBWINDOW( RIGHT_X, 320, (SUBWINDOW_WIDTH), 30, "^oAUTO MAP" )
	//SLIDER( RIGHT_X+2, 338, (SUBWINDOW_WIDTH)-4, 10, "^7Auto Map Zoom:", .2, 8, "cg_automapZoom" 5.159 1 7.43, "Auto map zoom level" )

	// Back Button
	BUTTON( 6, 366, SUBWINDOW_WIDTH, 18, "BACK", .3, 14, close xmod_display ; open xmod_options )
}
