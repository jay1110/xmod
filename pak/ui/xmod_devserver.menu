#include "ui/menudef.h"

// Defines //

#define WINDOW_X        0
#define WINDOW_Y        0
#define WINDOW_WIDTH    640
#define WINDOW_HEIGHT   480
#define GROUP_NAME      "grpWWWConfirm"

// Macros //

#include "ui/menumacros.h"
        
// WWW Confirmation Menu //
    
menuDef
{
    name        "xmod_devserver"
    visible     0
    fullscreen  0
    rect        WINDOW_X WINDOW_Y WINDOW_WIDTH WINDOW_HEIGHT
    style       WINDOW_STYLE_GRADIENT
    popup
    
    fadeClamp   1.5
    
    onOpen
    {
        setitemcolor background backcolor 0 0 0 0 ;
        fadein background
    }
    
    onESC
    {
        close xmod_devserver ;
        open xmod_options
    }
    
// Background //
    itemDef {
        name        "background"
        rect        0 0 640 480
        style       WINDOW_STYLE_GRADIENT
        //background "ui/assets/fadebox.tga"
        backcolor   0.01 0.01 0.01 .95
        visible     1
        decoration
    }

    itemDef {
        name        "window"
        group       GROUP_NAME
        rect        0 0 WINDOW_WIDTH WINDOW_HEIGHT
        style       WINDOW_STYLE_GRADIENT
        backcolor   0.01 0.01 0.01 .95
        border      WINDOW_BORDER_KCGRADIENT
        bordercolor .70 .70 .70  .60
        visible     1
        decoration
    }

// Subwindows //

#define SUBWINDOW_WIDTH     360
#define SUBWINDOW_HEIGHT    170
#define SUBWINDOW_X         .5 * (WINDOW_WIDTH - SUBWINDOW_WIDTH)
#define SUBWINDOW_Y         .5 * (WINDOW_HEIGHT - SUBWINDOW_HEIGHT)

    // Titelzeile
    SUBWINDOWBLACK( SUBWINDOW_X, SUBWINDOW_Y, SUBWINDOW_WIDTH, SUBWINDOW_HEIGHT, "^dXmod ^oDev-Servers" )

    // Server-Infos
    LABEL( SUBWINDOW_X+4, SUBWINDOW_Y+20, (SUBWINDOW_WIDTH)-8, 10,
           "-", .19, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-8), 8 )

    LABEL( SUBWINDOW_X+4, SUBWINDOW_Y+34, (SUBWINDOW_WIDTH)-8, 10,
           "-", .18, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-8), 8 )

    LABEL( SUBWINDOW_X+4, SUBWINDOW_Y+46, (SUBWINDOW_WIDTH)-8, 10,
           "^7IP:^3 xmod.etclan.de:27965", .18, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-8), 8 )

    LABEL( SUBWINDOW_X+4, SUBWINDOW_Y+58, (SUBWINDOW_WIDTH)-8, 10,
           "-", .18, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-8), 8 )

    LABEL( SUBWINDOW_X+4, SUBWINDOW_Y+72, (SUBWINDOW_WIDTH)-8, 10,
           "-", .18, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-8), 8 )

    LABEL( SUBWINDOW_X+4, SUBWINDOW_Y+86, (SUBWINDOW_WIDTH)-8, 10,
           "-", .18, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-8), 8 )

    LABEL( SUBWINDOW_X+4, SUBWINDOW_Y+100, (SUBWINDOW_WIDTH)-8, 10,
           "-", .17, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-8), 8 )

    LABEL( SUBWINDOW_X+4, SUBWINDOW_Y+114, (SUBWINDOW_WIDTH)-8, 10,
           "^7For support join:^3 discord.etclan.de", .17, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-8), 8 )

    LABEL( SUBWINDOW_X+4, SUBWINDOW_Y+130, (SUBWINDOW_WIDTH)-8, 10,
           "^7Connect to this server now?", .19, ITEM_ALIGN_CENTER, .5*((SUBWINDOW_WIDTH)-8), 8 )

    // Connect / Zurück
    BUTTON( SUBWINDOW_X+6, SUBWINDOW_Y+SUBWINDOW_HEIGHT-26,
            .5*(SUBWINDOW_WIDTH-18), 18,
            "YES", .3, 14,
            close xmod_devserver ; exec "connect etclan.de:27965" )

    BUTTON( SUBWINDOW_X+6+.5*(SUBWINDOW_WIDTH-18)+6, SUBWINDOW_Y+SUBWINDOW_HEIGHT-26,
            .5*(SUBWINDOW_WIDTH-18), 18,
            "NO", .3, 14,
            close xmod_devserver ; open xmod_options )
}
