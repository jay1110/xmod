<refentry id="cvar.g_doubleJump">

<refmeta>
    <refentrytitle>g_doubleJump</refentrytitle>
    <manvolnum>cvar</manvolnum>
</refmeta>

<refnamediv>
    <refname>g_doubleJump</refname>
    <refpurpose>toggle double jump</refpurpose>
</refnamediv>

<refsynopsisdiv>
    <cmdsynopsis>
        <command>g_doubleJump</command>
        <arg><replaceable>value</replaceable></arg>
    </cmdsynopsis>

<table id="cvar.g_doubleJump.values" frame="all">
<title>g_doubleJump Values</title>
<tgroup cols="2" align="left" colsep="1" rowsep="1">
    <colspec colnum="1" colwidth="9*" align="center"/>
    <colspec colnum="2" colwidth="91*"/>
    <thead>
        <row>
            <entry>VALUE</entry>
            <entry>DESCRIPTION</entry>
        </row>
    </thead>
    <tbody>
        <row>
            <entry>0</entry>
            <entry>Disable double jump</entry>
        </row>
        <row>
            <entry>1</entry>
            <entry>Enable - xmod style. Standard. Player must press jump within 850ms of the first jump.</entry>
        </row>
        <row>
            <entry>2</entry>
            <entry>Enable - nitmod style. The delay between pressing second time jumping is endless.</entry>
        </row>
    </tbody>
</tgroup>
</table>
</refsynopsisdiv>

<refsection>
<title>Default</title>
    <cmdsynopsis>
        <command>g_doubleJump</command>
        <arg choice="plain"><literal>0</literal></arg>
    </cmdsynopsis>
</refsection>

<refsection>
<title>Description</title>
<para>
    <command>g_doubleJump</command>
    controls whether players can perform a double jump (jump again while in mid-air).
    The second jump height is controlled by <command>g_DJHeight</command>.
</para>
</refsection>

</refentry>
