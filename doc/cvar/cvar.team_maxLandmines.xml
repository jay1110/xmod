<refentry id="cvar.team_maxLandmines">

<refmeta>
    <refentrytitle>team_maxLandmines</refentrytitle>
    <manvolnum>cvar</manvolnum>
</refmeta>

<refnamediv>
    <refname>team_maxLandmines</refname>
    <refpurpose>sets the maximum number of landmines per team</refpurpose>
</refnamediv>

<refsynopsisdiv>
    <cmdsynopsis>
        <command>team_maxLandmines</command>
        <arg><replaceable>count</replaceable></arg>
    </cmdsynopsis>
</refsynopsisdiv>

<refsection>
<title>Default</title>
    <cmdsynopsis>
        <command>team_maxLandmines</command>
        <arg choice="plain"><literal>10</literal></arg>
    </cmdsynopsis>
</refsection>

<refsection>
<title>Description</title>
<para>
    <command>team_maxLandmines</command>
    sets the maximum number of landmines per team.
</para>
</refsection>

</refentry>
