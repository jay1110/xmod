<refentry id="cvar.g_instantSpawn">

<refmeta>
    <refentrytitle>g_instantSpawn</refentrytitle>
    <manvolnum>cvar</manvolnum>
</refmeta>

<refnamediv>
    <refname>g_instantSpawn</refname>
    <refpurpose>enables instant spawning without waiting for the next spawn wave</refpurpose>
</refnamediv>

<refsynopsisdiv>
    <cmdsynopsis>
        <command>g_instantSpawn</command>
        <arg><replaceable>mode</replaceable></arg>
    </cmdsynopsis>
	&boolean.mode;
</refsynopsisdiv>

<refsection>
<title>Default</title>
    <cmdsynopsis>
        <command>g_instantSpawn</command>
        <arg choice="plain"><literal>0</literal></arg>
    </cmdsynopsis>
</refsection>

<refsection>
<title>Description</title>
<para>
    <command>g_instantSpawn</command>
    enables instant spawning without waiting for the next spawn wave.
</para>
</refsection>

</refentry>
