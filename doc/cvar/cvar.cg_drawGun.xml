<refentry id="cvar.cg_drawGun">

<refmeta>
    <refentrytitle>cg_drawGun</refentrytitle>
    <manvolnum>cvar</manvolnum>
</refmeta>

<refnamediv>
    <refname>cg_drawGun</refname>
    <refpurpose>set first-person weapon display mode</refpurpose>
</refnamediv>

<refsynopsisdiv>
    <cmdsynopsis>
        <command>cg_drawGun</command>
        <arg><replaceable>mode</replaceable></arg>
    </cmdsynopsis>

<table id="cvar.cg_drawGun.modes" frame="all">
<?dbfo table-width="50%"?>
<title>cg_drawGun Modes</title>
<tgroup cols="2" align="left" colsep="1" rowsep="1">
    <colspec colnum="1" colwidth="9*" align="center"/>
    <colspec colnum="2" colwidth="21*"/>
    <thead>
        <row>
            <entry>VALUE</entry>
            <entry>DESCRIPTION</entry>
        </row>
    </thead>
    <tbody>
        <row>
